    {
      "name": "mock-a2a",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "dev/mock-a2a.mjs"
      ],
      "port": 9997
    },
    {
      "name": "mock-mcp-client",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "dev/mock-mcp-client.mjs"
      ],
      "port": 9996
    }
  ]
}
