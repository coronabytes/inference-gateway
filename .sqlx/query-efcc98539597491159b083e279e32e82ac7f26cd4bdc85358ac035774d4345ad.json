{
  "db_name": "PostgreSQL",
  "query": "SELECT id, ts, actor_kind, actor_id, actor_name, action, target_type, target_id, target_name, details\n           FROM audit_log\n           WHERE ($2::text IS NULL OR target_type = $2)\n             AND ($3::text IS NULL OR strpos(lower(coalesce(target_name, '') || ' ' || coalesce(actor_name, '')), lower($3)) > 0)\n             AND ($4::timestamptz IS NULL OR ts >= $4)\n             AND ($5::timestamptz IS NULL OR ts < $5)\n           ORDER BY ts DESC LIMIT $1",
