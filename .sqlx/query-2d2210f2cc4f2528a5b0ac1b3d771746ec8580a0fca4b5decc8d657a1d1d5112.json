{
  "db_name": "PostgreSQL",
  "query": "SELECT id, name, project_id FROM virtual_keys\n           WHERE ($1::uuid[] IS NULL OR (project_id = ANY($1) AND scope IN ('inference', 'project')))\n             AND (NOT $2 OR (enabled AND scope IN ('inference', 'all') AND (expires_at IS NULL OR expires_at > now())))\n           ORDER BY lower(name)",
