  "query": "SELECT id, name, provider, secrets, settings AS \"settings: Json<CredentialSettings>\", created_at, updated_at\n           FROM credentials\n           WHERE ($1::text IS NULL OR strpos(lower(name), $1) > 0) AND ($2::text[] IS NULL OR provider = ANY($2))\n           ORDER BY provider, name",
