{
  "db_name": "PostgreSQL",
  "query": "SELECT upstream_kind, upstream_id, labels, created_at, expires_at, refresh_token IS NOT NULL AS \"refreshable!\", scope, connected_by, last_used_at\n           FROM oauth_tokens\n           WHERE upstream_kind = $1 AND upstream_id = $2 AND key_id = $3 AND labels <> '' AND string_to_array(labels, ',') @> $4\n           ORDER BY created_at DESC, labels LIMIT $5 OFFSET $6",
