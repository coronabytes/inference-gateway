# Local development settings. Copy to `.env` (gitignored) and fill in the secrets:
#
#   GATEWAY_MASTER_KEY:     openssl rand -hex 24
#   GATEWAY_ENCRYPTION_KEY: openssl rand -base64 32
#   POSTGRES_PASSWORD:      openssl rand -hex 16   (also put it into DATABASE_URL below)
#
# Read by `docker compose` (variable substitution) and by debug builds of the gateway
# (`cargo run`, IDE debugging). Release builds and the Docker image never read this file.
#
# Provider credentials (API keys, AWS keys) never go here: add them on the admin UI's
# Models page's Credentials tab, where they are stored encrypted in Postgres.

# --- secrets -----------------------------------------------------------------------------
# Optional once single sign-on is set up; empty means the admin UI only offers single sign-on.
GATEWAY_MASTER_KEY=
GATEWAY_ENCRYPTION_KEY=
POSTGRES_PASSWORD=

# --- docker compose: host ports (bound to 127.0.0.1) -------------------------------------
POSTGRES_PORT=5432
VALKEY_PORT=6379
GATEWAY_A_PORT=8081
GATEWAY_B_PORT=8082

# --- gateway run locally (cargo run / debugger) --------------------------------------------
DATABASE_URL=postgres://gateway:<POSTGRES_PASSWORD>@127.0.0.1:5432/gateway
VALKEY_URL=redis://127.0.0.1:6379
GATEWAY_LISTEN=127.0.0.1:8080
GATEWAY_INSTANCE_ID=local
GATEWAY_LOG=info,inference_gateway=debug
# Debug builds on loopback show a "Dev Login" button on the admin sign-in screen. Set to false to
# test single sign-on and the master key alone.
# GATEWAY_DEV_LOGIN=false
# Upstreams on this machine (dev/mock-upstream.mjs, Ollama, a local OIDC provider) are loopback
# addresses, which the gateway refuses unless they are listed here.
GATEWAY_UPSTREAM_ALLOWED_NETWORKS=127.0.0.0/8,::1

# Compile against the committed .sqlx metadata so `cargo build` works while Postgres is down.
# `cargo sqlx prepare` overrides this and checks queries against DATABASE_URL.
SQLX_OFFLINE=true
