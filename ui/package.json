{
  "name": "inference-gateway-ui",
  "private": true,
  "license": "AGPL-3.0-only",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "predev": "node scripts/fetch-scalar.mjs",
    "dev": "vite",
    "prebuild": "node scripts/fetch-scalar.mjs",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview",
    "lint": "biome lint",
    "test": "vitest run",
    "gen:api": "node tools/gen-api/node_modules/openapi-typescript/bin/cli.js openapi.json --empty-objects-unknown --output src/api.gen.ts"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "gen-api": "file:tools/gen-api",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
